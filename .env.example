# Copia este archivo a .env.local y completa con las credenciales de tu
# proyecto de Supabase (Project Settings > API). Sin estas variables la app
# funciona igual, pero guarda los datos solo en el navegador (localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Clave gratuita de FRED (https://fredaccount.stlouisfed.org/apikeys).
# Solo la usa la función serverless api/fred-sync.ts en el servidor; nunca
# llega al navegador. Necesaria para el botón "Sincronizar con FRED".
FRED_API_KEY=
